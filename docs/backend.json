{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Information about the registered user and their overall progress.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastActive": { "type": "string", "format": "date-time" },
        "role": { "type": "string", "enum": ["student", "moderator", "admin", "super-admin"], "default": "student" },
        "status": { "type": "string", "enum": ["active", "suspended", "banned"], "default": "active" },
        "subscriptionType": { "type": "string", "enum": ["free", "premium"], "default": "free" },
        "streak": { "type": "number", "default": 0 },
        "testsAttempted": { "type": "number", "default": 0 },
        "totalScore": { "type": "number", "default": 0 },
        "preferredLanguage": { "type": "string", "enum": ["en", "hn"], "default": "en" }
      },
      "required": ["uid", "email"]
    },
    "TestAttempt": {
      "title": "Test Attempt",
      "description": "Record of a completed mock test.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "testId": { "type": "string" },
        "examId": { "type": "string" },
        "examCategory": { "type": "string" },
        "score": { "type": "number" },
        "correctCount": { "type": "number" },
        "incorrectCount": { "type": "number" },
        "unattemptedCount": { "type": "number" },
        "accuracy": { "type": "number" },
        "timeTakenSeconds": { "type": "number" },
        "completedAt": { "type": "string", "format": "date-time" },
        "responses": { "type": "object" },
        "sectionPerformance": { "type": "array" }
      },
      "required": ["uid", "testId", "score"]
    },
    "TestProgress": {
      "title": "Active Test Progress",
      "description": "Transient state of an ongoing test for resume functionality.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "testId": { "type": "string" },
        "currentQuestionIndex": { "type": "number" },
        "timeLeftSeconds": { "type": "number" },
        "responses": { "type": "object" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      }
    },
    "ExamCategory": {
      "title": "Exam Category",
      "description": "Top-level groupings like SSC, Banking, or State Exams.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "iconName": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["title", "slug"]
    },
    "Exam": {
      "title": "Exam",
      "description": "Specific competitive exams like SSC CGL or BPSC.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "categoryId": { "type": "string" },
        "stateSlug": { "type": "string" },
        "description": { "type": "string" },
        "difficulty": { "type": "string", "enum": ["Easy", "Intermediate", "Hard"] },
        "testsCount": { "type": "number", "default": 0 },
        "questionsCount": { "type": "number", "default": 0 },
        "isActive": { "type": "boolean", "default": true }
      },
      "required": ["name", "slug", "categoryId"]
    },
    "MockTest": {
      "title": "Mock Test",
      "description": "Definition of a mock test series or practice set.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "categoryId": { "type": "string" },
        "examId": { "type": "string" },
        "type": { "type": "string", "enum": ["Full Test", "Subject Test", "Chapter Test", "Previous Year", "Daily Quiz", "Mini Mock"] },
        "subject": { "type": "string" },
        "chapter": { "type": "string" },
        "durationMinutes": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "totalMarks": { "type": "number" },
        "negativeMarks": { "type": "number" },
        "languages": { "type": "array", "items": { "type": "string" } },
        "instructions": { "type": "string" },
        "isFree": { "type": "boolean", "default": true },
        "status": { "type": "string", "enum": ["Draft", "Published", "Hidden", "Scheduled", "Archived"], "default": "Draft" },
        "visibility": { "type": "string", "enum": ["Public", "Premium", "Private"], "default": "Public" },
        "scheduledAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "slug", "examId", "type"]
    },
    "MockSection": {
      "title": "Mock Section",
      "description": "A section within a mock test (e.g., Mathematics).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "mockId": { "type": "string" },
        "title": {
          "type": "object",
          "properties": {
            "en": { "type": "string" },
            "hn": { "type": "string" }
          }
        },
        "order": { "type": "number" }
      }
    },
    "MockQuestion": {
      "title": "Mock Question",
      "description": "A specific question within a mock test.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "mockId": { "type": "string" },
        "sectionId": { "type": "string" },
        "en": { "type": "string" },
        "hn": { "type": "string" },
        "en_html": { "type": "string" },
        "hn_html": { "type": "string" },
        "status": { "type": "string", "enum": ["Draft", "Verified", "Needs Review", "Published"] },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "en": { "type": "string" },
              "hn": { "type": "string" },
              "en_html": { "type": "string" },
              "hn_html": { "type": "string" },
              "image": { "type": "string" }
            }
          }
        },
        "answer": { "type": "string" },
        "marks": { "type": "number" },
        "negativeMarks": { "type": "number" },
        "dom_images": { "type": "array", "items": { "type": "string" } },
        "memory_images": { "type": "array", "items": { "type": "string" } },
        "explanation": {
          "type": "object",
          "properties": {
            "en": { "type": "string" },
            "hn": { "type": "string" },
            "en_html": { "type": "string" },
            "hn_html": { "type": "string" }
          }
        }
      }
    }
  },
  "auth": {
    "providers": ["email/password", "google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user profile and aggregate stats."
    },
    "/attempts/{attemptId}": {
      "schema": "TestAttempt",
      "description": "Historical records of every test submitted."
    },
    "/progress/{userId}/activeTests/{testId}": {
      "schema": "TestProgress",
      "description": "Real-time sync of current test state."
    },
    "/examCategories/{categoryId}": {
      "schema": "ExamCategory",
      "description": "Core exam categories."
    },
    "/exams/{examId}": {
      "schema": "Exam",
      "description": "Specific competitive exams."
    },
    "/mockTests/{mockId}": {
      "schema": "MockTest",
      "description": "Detailed configuration of each mock test."
    },
    "/mockTests/{mockId}/sections/{sectionId}": {
      "schema": "MockSection",
      "description": "Sections within a specific mock test."
    },
    "/mockTests/{mockId}/questions/{questionId}": {
      "schema": "MockQuestion",
      "description": "Questions within a specific mock test."
    }
  }
}
