
{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Information about the registered user and their overall progress.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastActive": { "type": "string", "format": "date-time" },
        "role": { "type": "string", "enum": ["student", "moderator", "admin", "super-admin", "content-manager", "support-staff"], "default": "student" },
        "status": { "type": "string", "enum": ["active", "suspended", "banned"], "default": "active" },
        "subscriptionType": { "type": "string", "enum": ["free", "premium"], "default": "free" },
        "streak": { "type": "number", "default": 0 },
        "testsAttempted": { "type": "number", "default": 0 },
        "totalScore": { "type": "number", "default": 0 },
        "preferredLanguage": { "type": "string", "enum": ["en", "hn"], "default": "en" }
      },
      "required": ["uid", "email"]
    },
    "MockType": {
      "title": "Mock Test Category",
      "description": "Top-level category for mock tests (e.g., Full Test, Subject Test).",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "order": { "type": "number" },
        "isActive": { "type": "boolean" },
        "deleted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "MockSubType": {
      "title": "Mock Test Sub-Category",
      "description": "Nested category under a MockType (e.g., Mathematics under Subject Test).",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "order": { "type": "number" },
        "isActive": { "type": "boolean" },
        "deleted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "AuditLog": {
      "title": "Audit Log",
      "description": "System-wide tracking of administrative actions.",
      "type": "object",
      "properties": {
        "adminId": { "type": "string" },
        "adminName": { "type": "string" },
        "action": { "type": "string" },
        "targetId": { "type": "string" },
        "targetType": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["email/password", "google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user profile and aggregate stats."
    },
    "/mockTypes/{typeId}": {
      "schema": "MockType",
      "description": "Defines global mock test categories."
    },
    "/mockTypes/{typeId}/subTypes/{subTypeId}": {
      "schema": "MockSubType",
      "description": "Defines nested sub-categories (subjects/chapters)."
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Administrative action history."
    }
  }
}
