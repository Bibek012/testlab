{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Information about the registered user and their overall progress.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastActive": { "type": "string", "format": "date-time" },
        "role": { "type": "string", "enum": ["student", "moderator", "admin", "super-admin", "content-manager", "support-staff"], "default": "student" },
        "status": { "type": "string", "enum": ["active", "suspended", "banned"], "default": "active" },
        "subscriptionType": { "type": "string", "enum": ["free", "premium"], "default": "free" },
        "streak": { "type": "number", "default": 0 },
        "testsAttempted": { "type": "number", "default": 0 },
        "totalScore": { "type": "number", "default": 0 },
        "preferredLanguage": { "type": "string", "enum": ["en", "hn"], "default": "en" }
      },
      "required": ["uid", "email"]
    },
    "MockType": {
      "title": "Exam-Specific Mock Category",
      "description": "Custom category under a specific exam (e.g., Full Test, Mains).",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "order": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "MockSubType": {
      "title": "Nested Subject/Chapter",
      "description": "Subject or Chapter linked to a MockType (e.g., Math under Subject Test).",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "order": { "type": "number" },
        "isActive": { "type": "boolean" }
      }
    }
  },
  "auth": {
    "providers": ["email/password", "google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user profile and aggregate stats."
    },
    "/exams/{examId}/mockTypes/{typeId}": {
      "schema": "MockType",
      "description": "Exam-specific test categories."
    },
    "/exams/{examId}/mockTypes/{typeId}/subTypes/{subTypeId}": {
      "schema": "MockSubType",
      "description": "Nested level (Subject/Chapter) for that exam."
    },
    "/mockTests/{testId}": {
      "schema": "object",
      "description": "The mock test root containing flattened metadata."
    }
  }
}